{
  // Checks the Defesa Civil modules. The plugin runs as plain JavaScript on Studio's Node, with no build step, so this never emits anything.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "dom.asynciterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "files": [
    "com.ulanzi.systemmonitorpro.ulanziPlugin/plugin/alert-types.d.ts",
    "com.ulanzi.systemmonitorpro.ulanziPlugin/plugin/alert-area.js",
    "com.ulanzi.systemmonitorpro.ulanziPlugin/plugin/cap-feed.js",
    "com.ulanzi.systemmonitorpro.ulanziPlugin/plugin/defesa-civil-api.js",
    "com.ulanzi.systemmonitorpro.ulanziPlugin/plugin/defesa-civil-service.js"
  ]
}
